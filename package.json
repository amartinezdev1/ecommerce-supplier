{
  "name": "rpm-rebajas-por-minuto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/prepare-client.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-client.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/api-integration.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-data.mjs",
    "check:deploy": "node --env-file-if-exists=.env.local scripts/check-deploy.mjs",
    "export:vercel": "node scripts/export-vercel.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "fflate": "^0.8.3",
    "lucide": "^1.78.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/pg": "^8.15.6",
    "typescript": "5.9.3",
    "esbuild": "^0.25.12"
  }
}
