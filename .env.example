# Public URL of this deployment, without a trailing slash (localhost for development).
APP_URL=http://localhost:8871
# Verified email of the main administrator. Never expose this in browser JavaScript.
RPM_ADMIN_EMAIL=admin@example.com
# Copy the Transaction pooler URL from Supabase > Connect. URL-encode password characters.
# Use port 6543 for Vercel functions. Do not disable SSL verification.
DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase > Project Settings > API. All variables below remain server-side.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=rpm-products
